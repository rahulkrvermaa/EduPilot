# =====================================================
# EduPilot Frontend Environment Variables
# =====================================================
# Copy this file to ".env" and adjust as needed.
#
# Vite reads .env files at the project root. Only variables prefixed
# with VITE_ are exposed to the client bundle (this is a security
# feature — do not put secrets here).
# =====================================================


# =====================================================
# App identity
# =====================================================
# Display name. Used for the document title and any in-app branding.
VITE_APP_NAME=EduPilot

# Public environment label (development | staging | production).
# Useful for "You are on staging" banners.
VITE_ENV=development

# Default theme for first-time visitors: light | dark | system.
VITE_DEFAULT_THEME=system


# =====================================================
# Backend API connection
# =====================================================
# Base URL of the FastAPI backend. Must include scheme and (optionally) port.
# - Local dev   : http://127.0.0.1:8000
# - LAN testing : http://192.168.1.10:8000
# - Production  : https://api.edupilot.example.com
VITE_API_URL=http://127.0.0.1:8000

# API request timeout, in milliseconds. 0 disables timeout.
VITE_API_TIMEOUT_MS=30000

# Number of retry attempts for transient (5xx / 429) responses.
VITE_API_RETRY_COUNT=1

# Initial retry delay, in milliseconds (exponential backoff base).
VITE_API_RETRY_DELAY_MS=600


# =====================================================
# Authentication
# =====================================================
# localStorage key used to persist the access token.
# Change this if multiple EduPilot tenants share the same browser profile.
VITE_TOKEN_STORAGE_KEY=edupilotToken


# =====================================================
# File uploads
# =====================================================
# Maximum file size in bytes that the client will accept in the upload UI.
# Keep this in sync with the backend's MAX_UPLOAD_BYTES.
VITE_MAX_UPLOAD_BYTES=10485760

# Comma-separated list of accepted file extensions in the upload picker.
VITE_UPLOAD_ACCEPTED_EXTENSIONS=.pdf,.doc,.docx,.txt


# =====================================================
# Feature flags
# =====================================================
# Set to false to hide the "Generate Quiz with AI" button.
VITE_FEATURE_AI_QUIZ=true
# Set to false to hide the "AI Tutor" navigation entry.
VITE_FEATURE_AI_TUTOR=true
# Set to false to hide the "Documents" page.
VITE_FEATURE_DOCUMENTS=true
# Set to false to hide the "Study Plan" page.
VITE_FEATURE_STUDY_PLAN=true
# Set to false to hide the "Quiz History" page.
VITE_FEATURE_QUIZ_HISTORY=true


# =====================================================
# Analytics / observability (opt-in)
# =====================================================
# Public site/measurement id for analytics tools.
# Leave blank to disable analytics entirely.
VITE_ANALYTICS_ID=


# =====================================================
# Server-side hint (read by Vite dev server / preview)
# =====================================================
# Port the Vite dev server binds to. NOT used by the deployed bundle.
VITE_DEV_SERVER_PORT=5173
VITE_API_URL=http://127.0.0.1:8000
VITE_APP_NAME=EduPilot