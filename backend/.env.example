# =====================================================
# EduPilot Backend Environment Variables
# =====================================================
# Copy this file to ".env" and fill in real values.
# Never commit a real .env to version control.
#
# All variables shown below are read by the backend.
#   - DATABASE_URL, DB_POOL_*, SECRET_KEY, ACCESS_TOKEN_EXPIRE_MINUTES
#     GEMINI_API_KEY, GEMINI_MODEL, MAX_UPLOAD_BYTES, CORS_ORIGINS
#   - HOST, PORT, RELOAD, LOG_LEVEL, WORKERS
#     (consumed by the run command, not by app code; listed for clarity)
# =====================================================


# =====================================================
# Runtime / Server (consumed by `uvicorn main:app`)
# =====================================================
# Bind address. Use 0.0.0.0 to accept connections from outside the host.
HOST=127.0.0.1
# Port that the FastAPI server listens on.
PORT=8000
# Auto-reload on code changes (development only). Use 0 in production.
RELOAD=1
# Number of worker processes. Increase for production.
WORKERS=1
# Logging level: critical, error, warning, info, debug, trace.
LOG_LEVEL=info


# =====================================================
# Database
# =====================================================
# PostgreSQL connection string.
# Format: postgresql://<user>:<password>@<host>:<port>/<database>
# Special characters in the password MUST be URL-encoded
# (e.g. "@" -> "%40", "#" -> "%23", " " -> "%20").
#
# Examples:
#   Local dev : postgresql://postgres:postgres@localhost:5432/edupilot
#   Docker    : postgresql://edupilot:edupilot@db:5432/edupilot
#   Cloud     : postgresql://user:pass@db.example.com:5432/edupilot?sslmode=require
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/edupilot

# Connection pool tuning.
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
# Recycle connections older than this many seconds (avoids stale TCP).
DB_POOL_RECYCLE=1800
# Max seconds to wait for a connection from the pool.
DB_POOL_TIMEOUT=30
# Enable SQLAlchemy SQL logging (development only). true / false.
DB_ECHO=false


# =====================================================
# Authentication / JWT
# =====================================================
# Secret used to sign access tokens.
# Generate a strong value with:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
# NEVER reuse the example below in any deployed environment.
SECRET_KEY=replace-with-a-long-random-secret-min-32-chars

# JWT signing algorithm. HS256 is supported by python-jose by default.
JWT_ALGORITHM=HS256

# How long access tokens stay valid, in minutes.
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Optional issuer / audience claims. Leave blank to disable.
JWT_ISSUER=
JWT_AUDIENCE=


# =====================================================
# AI / Google Gemini
# =====================================================
# Get your API key from https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your-gemini-api-key

# Model name. Pick a current Gemini model.
GEMINI_MODEL=gemini-3.6-flash

# Optional per-request timeout for AI calls (seconds).
GEMINI_TIMEOUT_SECONDS=60

# Optional max output tokens per AI response.
GEMINI_MAX_OUTPUT_TOKENS=2048


# =====================================================
# Uploads / File handling
# =====================================================
# Maximum size of an uploaded file, in bytes. Default 10 MB (10485760).
MAX_UPLOAD_BYTES=10485760

# Comma-separated list of accepted MIME types for uploads.
UPLOAD_ALLOWED_TYPES=application/pdf,application/msword,application/vnd.openxmlformats-officedocument.wordprocessingml.document,text/plain

# Directory where uploaded files are stored (absolute path).
# Leave blank to use the backend's default storage location.
UPLOAD_DIR=


# =====================================================
# CORS
# =====================================================
# Comma-separated list of allowed frontend origins.
# - Local dev: http://localhost:5173,http://127.0.0.1:5173
# - Production: https://edupilot.example.com
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Comma-separated allowed CORS methods.
CORS_METHODS=GET,POST,PUT,PATCH,DELETE,OPTIONS

# Comma-separated allowed CORS headers.
CORS_HEADERS=Authorization,Content-Type,Accept,Origin,X-Requested-With

# CORS preflight cache lifetime, in seconds.
CORS_MAX_AGE=600


# =====================================================
# Observability / Feature flags
# =====================================================
# Set to true to expose FastAPI's /docs and /redoc routes.
ENABLE_DOCS=true
# Set to true to enable request timing logs.
REQUEST_LOGGING=false


# =====================================================
# Frontend hand-off (for documentation / tooling)
# =====================================================
# These VITE_* names are what the React app reads. Set them in the
# frontend's own .env file. Listed here so the two .env files stay in sync.
#
# VITE_API_URL=http://127.0.0.1:8000
# VITE_APP_NAME=EduPilot
